root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = false
trim_trailing_whitespace = true

[*.py]
insert_final_newline = true

[*.{mjs,json}]
indent_style = tab
insert_final_newline = true

[*.{yml,yaml,md}]
indent_size = 2
insert_final_newline = true